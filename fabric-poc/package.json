{
  "name": "garments-fabric-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8765 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 8766 --strictPort",
    "lint": "cd .. && node fabric-poc/node_modules/eslint/bin/eslint.js fabric-poc scripts/ci database/ci/seed.mjs server/mail deploy/cloudflare-mailer",
    "check:unused": "knip",
    "check:duplicates": "jscpd --config .jscpd.json",
    "quality": "npm run check:coherence && npm run typecheck && npm run lint && npm run format:check && npm run check:unused && npm run check:duplicates && npm test && npm run build",
    "check:coherence": "node ../scripts/check-coherence.mjs && node --test ../scripts/coherence*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css}\" \"tests/**/*.js\" \"e2e/**/*.js\" \"*.config.js\" \"integration/**/*.mjs\" \"../scripts/ci/*.{mjs,ts}\" \"../database/ci/seed.mjs\" \"../.github/**/*.{yml,yaml}\" \"../deploy/**/*.json\" \"../server/mail/*.mjs\" \"../deploy/cloudflare-mailer/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css}\" \"tests/**/*.js\" \"e2e/**/*.js\" \"*.config.js\" \"integration/**/*.mjs\" \"../scripts/ci/*.{mjs,ts}\" \"../database/ci/seed.mjs\" \"../.github/**/*.{yml,yaml}\" \"../deploy/**/*.json\" \"../server/mail/*.mjs\" \"../deploy/cloudflare-mailer/**/*.mjs\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fortune-sheet/react": "1.0.4",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-table": "8.21.3",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/preset-sheets-filter": "1.2.0",
    "@univerjs/preset-sheets-sort": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-select": "5.10.2",
    "tabulator-tables": "6.7.1",
    "tailwind-merge": "2.6.0",
    "tunnel-rat": "0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "uuid": "11.1.1",
    "minimatch": "11.0.1"
  }
}
